# ============================================================
# OpenBull Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ---- Core Secrets (REQUIRED - generate unique values) ----
APP_SECRET_KEY = "CHANGE_ME_generate_with_secrets_token_hex_32"
ENCRYPTION_PEPPER = "CHANGE_ME_generate_with_secrets_token_hex_32"
# Optional. ENCRYPTION_PEPPER is mixed into every Argon2 password / API-key
# hash; setting this gives Fernet (broker tokens, api_secret) its own key
# material so one leaked value does not compromise both. Safe to enable on an
# existing install: rows encrypted under the old key still decrypt and are
# re-encrypted when next written. Once set, do NOT change it without
# re-encrypting.
ENCRYPTION_SECRET = ""

# ---- Database (REQUIRED - no default) ----
# There is deliberately no built-in fallback; the previous default shipped a
# guessable password.
DATABASE_URL = "postgresql+asyncpg://openbull:CHANGE_ME@127.0.0.1:5432/openbull"

# ---- Server ----
BACKEND_HOST = "127.0.0.1"
BACKEND_PORT = 8000
FRONTEND_URL = "http://localhost:5173"

# ---- CORS ----
CORS_ORIGINS = "http://127.0.0.1:5173,http://localhost:5173"

# ---- Brokers ----
# UI-facing list only. It is NOT a security boundary: broker module imports
# are validated against the broker packages actually installed under
# backend/broker/ (see backend.utils.plugin_loader.validate_broker_name).
VALID_BROKERS = "upstox,zerodha"

# ---- Logging ----
LOG_LEVEL = "INFO"
# Rotating file handlers under LOG_DIR. Two files: openbull.log (all levels)
# and openbull-error.log (WARNING+). Each file caps on-disk size at
# (LOG_FILE_BACKUP_COUNT + 1) * LOG_FILE_MAX_MB. Defaults => 100 MB per file.
LOG_TO_FILE = "true"
LOG_DIR = "logs"
LOG_FILE_MAX_MB = 10
LOG_FILE_BACKUP_COUNT = 9
LOG_COLORS = "true"
# DB-backed WARNING+ sink. Old rows are trimmed when this many are exceeded.
ERROR_LOG_DB_MAX_ROWS = 50000

# ---- Rate Limits ----
LOGIN_RATE_LIMIT_MIN = "5 per minute"
LOGIN_RATE_LIMIT_HOUR = "25 per hour"
API_RATE_LIMIT = "50 per second"
ORDER_RATE_LIMIT = "10 per second"

# ---- Session ----
SESSION_EXPIRY_TIME = "03:00"
# Secure flag on the session cookie. The code default is now TRUE, so local
# http://127.0.0.1 development MUST set this to false or the browser will not
# send the cookie over plain HTTP. Production (HTTPS) leaves it true.
COOKIE_SECURE = "false"

# ---- Reverse proxy / host hardening ----
# Peers allowed to set X-Forwarded-For / X-Real-IP. Anything not listed here
# has its forwarded headers ignored and is identified by its socket address.
# Empty disables forwarded headers entirely. Required because nginx APPENDS
# to a client-supplied XFF, so without a trust boundary the leftmost entry is
# attacker-controlled (it fed the webhook IP allow-list and api_logs).
TRUSTED_PROXY_IPS = "127.0.0.1,::1"
# Host header allow-list for TrustedHostMiddleware; empty = allow any (dev).
# Set to your domain in production — Starlette does not validate Host itself.
ALLOWED_HOSTS = ""
# Retention cap for sm_webhook_event (the webhook endpoint is unauthenticated
# by design and records rejections too, so the table needs a bound).
WEBHOOK_EVENT_MAX_ROWS = 50000

# ---- WebSocket Proxy ----
WEBSOCKET_HOST = "127.0.0.1"
WEBSOCKET_PORT = 8765
WEBSOCKET_URL = "ws://127.0.0.1:8765"
ZMQ_HOST = "127.0.0.1"
ZMQ_PORT = 5555

# ---- Redis (cache backend) ----
REDIS_URL = "redis://127.0.0.1:6379/0"

# ---- WebSocket Connection Pooling ----
# Most brokers limit symbols per WebSocket (Upstox: 1000, Zerodha: 3000)
# Total capacity = MAX_SYMBOLS_PER_WEBSOCKET x MAX_WEBSOCKET_CONNECTIONS
MAX_SYMBOLS_PER_WEBSOCKET = 1000
MAX_WEBSOCKET_CONNECTIONS = 3
ENABLE_CONNECTION_POOLING = "true"
